{
  "ignore": [".workflow/**", "corpus/**"],
  "format": { "enabled": false },
  "actionableWarnings": { "autoFix": { "enabled": false } },
  "rules": {
    "unchecked-throwing-call-python": {
      "disable": ["ast-grep:unchecked-throwing-call-python"]
    },
    "reportMissingImports": {
      "disable": ["Pyright:reportMissingImports", "reportMissingImports"]
    }
  }
}
